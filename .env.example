# ==================================================
# Farmer AI - Environment Variables Example
# ==================================================
# Never commit your real secrets to version control.
# Copy this file to .env.local for local development.

# Google Gemini API key (Required for AI Agriculture Chat Agent & Disease Vision Analysis)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=


# Database connection URL (PostgreSQL for production on Supabase, Neon, or Vercel Postgres)
# Example: postgresql://username:password@localhost:5432/farmer_ai?schema=public
DATABASE_URL=
